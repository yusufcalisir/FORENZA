{
  "$schema": "https://json.schemastore.org/architecture-topology.json",
  "name": "FORENZA Production Infrastructure & Multi-Tier Segmentation Topology",
  "version": "2.0.0",
  "layers": [
    {
      "tier": 1,
      "name": "Internet Edge / Anycast CDN & DDoS Shield",
      "components": ["Cloudflare Anycast", "Edge DDoS Rate Limiter", "Edge WAF"],
      "network_zone": "PUBLIC_INTERNET",
      "controls": [
        "TLS 1.3 Strict Mode",
        "HSTS Preload max-age=63072000",
        "L3/L4/L7 Volumetric Scrubbing",
        "Search Engine & Accessibility Whitelist"
      ]
    },
    {
      "tier": 2,
      "name": "Origin Ingress & Load Balancer",
      "components": ["Envoy / NGINX Ingress Proxy"],
      "network_zone": "DMZ_INGRESS",
      "controls": [
        "Origin Cloaking (Header: X-Origin-Verify-Secret)",
        "Direct Public IP Drop (403 Forbidden)",
        "Slowloris 10s Header Timeout",
        "Connection Pool Governor (Max 25/IP)"
      ]
    },
    {
      "tier": 3,
      "name": "Application & Forensic Compute Cluster",
      "components": ["FastAPI Biocomputational Workers", "Groth16 ZKP Prover", "MCMC Mixture Deconvolution Engine"],
      "network_zone": "PRIVATE_APP_VPC (10.100.1.0/24)",
      "controls": [
        "Non-routable internal IP space",
        "Circuit Breakers on Database & Compute",
        "Short-lived 15m Tokens + Refresh Token Rotation",
        "No root / Read-only container rootfs"
      ]
    },
    {
      "tier": 4,
      "name": "Private Database & Vault Storage",
      "components": ["PostgreSQL 16 Enterprise", "Redis Cache / Session Store", "Vault Secrets Engine"],
      "network_zone": "PRIVATE_DB_VPC (10.100.2.0/24)",
      "controls": [
        "Zero Public IP / Restricted Ports (5432, 6379 strictly internal)",
        "mTLS Encrypted Connections",
        "Connection Pooling (Max 50 connections, 5s timeout)",
        "AES-256-GCM / ChaCha20-Poly1305 Data-at-Rest Encryption"
      ]
    }
  ]
}

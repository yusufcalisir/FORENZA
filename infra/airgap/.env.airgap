# ==============================================================================
# FORENZA: Forensic Evidence Operating System
# Air-Gapped Environment Configuration
# ==============================================================================

# Core System & Operational Flags
FORENZA_ENV=production
AIRGAP_MODE=true
OFFLINE_SIMULATION=true
LOG_LEVEL=info

# Gateway & Ports
GATEWAY_HTTP_PORT=8080
GATEWAY_HTTPS_PORT=8443
BACKEND_PORT=8000
FRONTEND_PORT=3000

# PostgreSQL Configuration
POSTGRES_USER=forenza
POSTGRES_PASSWORD=forenza_airgap_secure_pass_2026
POSTGRES_DB=forenza_lims
POSTGRES_PORT=5432
DATABASE_URL=postgresql://forenza:forenza_airgap_secure_pass_2026@postgres:5432/forenza_lims

# Redis Task Queue & Cache
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Cryptographic & Security Keys (HMAC SHA-256 / JWT)
SECRET_KEY=forenza_airgap_master_hmac_sha256_kdf_2026_secure_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Next.js Internal Gateway URL
NEXT_PUBLIC_API_URL=https://localhost:8443
NEXT_PUBLIC_AIRGAP_MODE=true
NEXT_TELEMETRY_DISABLED=1
